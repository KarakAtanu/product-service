{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "4144925669905106065"
    }
  },
  "parameters": {
    "appUniqueName": {
      "type": "string",
      "metadata": {
        "description": "Application Registration unique name."
      }
    },
    "githubIssuer": {
      "type": "string",
      "defaultValue": "https://token.actions.githubusercontent.com",
      "metadata": {
        "description": "GitHub Actions OIDC issuer."
      }
    },
    "githubAudience": {
      "type": "string",
      "defaultValue": "api://AzureADTokenExchange",
      "metadata": {
        "description": "GitHub Actions OIDC audience."
      }
    },
    "githubSubject": {
      "type": "string",
      "metadata": {
        "description": "GitHub Actions OIDC subject."
      }
    },
    "federatedCredentialName": {
      "type": "string",
      "defaultValue": "github-development",
      "metadata": {
        "description": "Federated credential name."
      }
    },
    "federatedCredentialDescription": {
      "type": "string",
      "defaultValue": "Trust GitHub Actions from the development environment.",
      "metadata": {
        "description": "Description of the federated credential."
      }
    }
  },
  "imports": {
    "microsoftGraphV1": {
      "provider": "MicrosoftGraph",
      "version": "1.0.0"
    }
  },
  "resources": {
    "cicdApplication::githubFederatedCredential": {
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/applications/federatedIdentityCredentials@v1.0",
      "properties": {
        "name": "[format('{0}/{1}', parameters('appUniqueName'), parameters('federatedCredentialName'))]",
        "audiences": [
          "[parameters('githubAudience')]"
        ],
        "issuer": "[parameters('githubIssuer')]",
        "subject": "[parameters('githubSubject')]",
        "description": "[parameters('federatedCredentialDescription')]"
      }
    },
    "cicdApplication": {
      "existing": true,
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/applications@v1.0",
      "properties": {
        "uniqueName": "[parameters('appUniqueName')]"
      }
    },
    "cicdServicePrincipal": {
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/servicePrincipals@v1.0",
      "properties": {
        "appId": "[reference('cicdApplication').appId]"
      },
      "dependsOn": [
        "cicdApplication"
      ]
    }
  }
}