{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "6472100231603788073"
    }
  },
  "parameters": {
    "appDisplayName": {
      "type": "string",
      "defaultValue": "app-product-github-cicd-dev",
      "metadata": {
        "description": "Display name of the CI/CD application."
      }
    },
    "appUniqueName": {
      "type": "string",
      "defaultValue": "productServiceGithubCicdDev",
      "metadata": {
        "description": "Immutable unique name for the Entra application."
      }
    }
  },
  "imports": {
    "microsoftGraphV1": {
      "provider": "MicrosoftGraph",
      "version": "1.0.0"
    }
  },
  "resources": {
    "cicdApplication": {
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/applications@v1.0",
      "properties": {
        "displayName": "[parameters('appDisplayName')]",
        "uniqueName": "[parameters('appUniqueName')]",
        "description": "Workload identity for GitHub Actions CI/CD deployment of Product API.",
        "signInAudience": "AzureADMyOrg"
      }
    }
  }
}