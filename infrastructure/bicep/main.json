{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "3057263693062842533"
    }
  },
  "parameters": {
    "resourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "Resource group name."
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "acrName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique Azure Container Registry name."
      }
    },
    "logAnalyticsName": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace name."
      }
    },
    "containerAppsEnvironmentName": {
      "type": "string",
      "metadata": {
        "description": "Container Apps Environment name."
      }
    },
    "managedIdentityName": {
      "type": "string",
      "metadata": {
        "description": "User Assigned Managed Identity name."
      }
    },
    "githubSubject": {
      "type": "string",
      "metadata": {
        "description": "GitHub Actions OIDC subject for the development environment."
      }
    },
    "githubActionsSpObjectId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the GitHub Actions Service Principal."
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "test",
        "prod"
      ],
      "metadata": {
        "description": "Allowed deployment environments."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Additional resource tags."
      }
    }
  },
  "variables": {
    "commonTags": "[union(parameters('tags'), createObject('Environment', parameters('environment'), 'Project', 'ProductAPI', 'ManagedBy', 'Bicep'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2025-04-01",
      "name": "[parameters('resourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "githubIdentityLinksDeployment",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "appUniqueName": {
            "value": "productServiceGithubCicdDev"
          },
          "githubSubject": {
            "value": "[parameters('githubSubject')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "languageVersion": "2.0",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.49.2.45890",
              "templateHash": "4144925669905106065"
            }
          },
          "parameters": {
            "appUniqueName": {
              "type": "string",
              "metadata": {
                "description": "Application Registration unique name."
              }
            },
            "githubIssuer": {
              "type": "string",
              "defaultValue": "https://token.actions.githubusercontent.com",
              "metadata": {
                "description": "GitHub Actions OIDC issuer."
              }
            },
            "githubAudience": {
              "type": "string",
              "defaultValue": "api://AzureADTokenExchange",
              "metadata": {
                "description": "GitHub Actions OIDC audience."
              }
            },
            "githubSubject": {
              "type": "string",
              "metadata": {
                "description": "GitHub Actions OIDC subject."
              }
            },
            "federatedCredentialName": {
              "type": "string",
              "defaultValue": "github-development",
              "metadata": {
                "description": "Federated credential name."
              }
            },
            "federatedCredentialDescription": {
              "type": "string",
              "defaultValue": "Trust GitHub Actions from the development environment.",
              "metadata": {
                "description": "Description of the federated credential."
              }
            }
          },
          "imports": {
            "microsoftGraphV1": {
              "provider": "MicrosoftGraph",
              "version": "1.0.0"
            }
          },
          "resources": {
            "cicdApplication::githubFederatedCredential": {
              "import": "microsoftGraphV1",
              "type": "Microsoft.Graph/applications/federatedIdentityCredentials@v1.0",
              "properties": {
                "name": "[format('{0}/{1}', parameters('appUniqueName'), parameters('federatedCredentialName'))]",
                "audiences": [
                  "[parameters('githubAudience')]"
                ],
                "issuer": "[parameters('githubIssuer')]",
                "subject": "[parameters('githubSubject')]",
                "description": "[parameters('federatedCredentialDescription')]"
              }
            },
            "cicdApplication": {
              "existing": true,
              "import": "microsoftGraphV1",
              "type": "Microsoft.Graph/applications@v1.0",
              "properties": {
                "uniqueName": "[parameters('appUniqueName')]"
              }
            },
            "cicdServicePrincipal": {
              "import": "microsoftGraphV1",
              "type": "Microsoft.Graph/servicePrincipals@v1.0",
              "properties": {
                "appId": "[reference('cicdApplication').appId]"
              },
              "dependsOn": [
                "cicdApplication"
              ]
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "acrDeployment",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "acrName": {
            "value": "[parameters('acrName')]"
          },
          "githubActionsSpObjectId": {
            "value": "[parameters('githubActionsSpObjectId')]"
          },
          "tags": {
            "value": "[variables('commonTags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.49.2.45890",
              "templateHash": "17593524448788880809"
            }
          },
          "parameters": {
            "acrName": {
              "type": "string",
              "minLength": 5,
              "maxLength": 24,
              "metadata": {
                "description": "Globally unique Azure Container Registry name."
              }
            },
            "githubActionsSpObjectId": {
              "type": "string",
              "metadata": {
                "description": "Object ID of GitHub Actions CI/CD Service Principal."
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Resource tags."
              }
            }
          },
          "variables": {
            "repositoryWriterRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '2a1e307c-b015-4ebd-883e-5b7698a07328')]",
            "githubWriterCondition": "(\r\n  (\r\n    !(ActionMatches{'Microsoft.ContainerRegistry/registries/repositories/metadata/read'})\r\n    AND\r\n    !(ActionMatches{'Microsoft.ContainerRegistry/registries/repositories/content/read'})\r\n    AND\r\n    !(ActionMatches{'Microsoft.ContainerRegistry/registries/repositories/metadata/write'})\r\n    AND\r\n    !(ActionMatches{'Microsoft.ContainerRegistry/registries/repositories/content/write'})\r\n  )\r\n  OR\r\n  (\r\n    @Request[Microsoft.ContainerRegistry/registries/repositories:name] StringEqualsIgnoreCase 'product-api'\r\n  )\r\n)\r\n"
          },
          "resources": [
            {
              "type": "Microsoft.ContainerRegistry/registries",
              "apiVersion": "2025-11-01",
              "name": "[parameters('acrName')]",
              "location": "[resourceGroup().location]",
              "sku": {
                "name": "Basic"
              },
              "properties": {
                "adminUserEnabled": false,
                "publicNetworkAccess": "Enabled",
                "roleAssignmentMode": "AbacRepositoryPermissions",
                "policies": {
                  "azureADAuthenticationAsArmPolicy": {
                    "status": "enabled"
                  }
                }
              },
              "tags": "[parameters('tags')]"
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2020-04-01-preview",
              "scope": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
              "name": "[guid(parameters('acrName'), parameters('githubActionsSpObjectId'), variables('repositoryWriterRoleDefinitionId'))]",
              "properties": {
                "roleDefinitionId": "[variables('repositoryWriterRoleDefinitionId')]",
                "principalId": "[parameters('githubActionsSpObjectId')]",
                "principalType": "ServicePrincipal",
                "description": "Grant GitHub Actions to push and pull images only in product-service repository.",
                "condition": "[variables('githubWriterCondition')]",
                "conditionVersion": "2.0"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]"
              ]
            }
          ],
          "outputs": {
            "acrId": {
              "type": "string",
              "value": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]"
            },
            "acrName": {
              "type": "string",
              "value": "[parameters('acrName')]"
            },
            "acrLoginServer": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), '2025-11-01').loginServer]"
            },
            "githubActionsSpRoleAssignmentId": {
              "type": "string",
              "value": "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), 'Microsoft.Authorization/roleAssignments', guid(parameters('acrName'), parameters('githubActionsSpObjectId'), variables('repositoryWriterRoleDefinitionId')))]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "containerPlatformDeployment",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "logAnalyticsName": {
            "value": "[parameters('logAnalyticsName')]"
          },
          "containerAppsEnvironmentName": {
            "value": "[parameters('containerAppsEnvironmentName')]"
          },
          "managedIdentityName": {
            "value": "[parameters('managedIdentityName')]"
          },
          "acrName": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'acrDeployment'), '2025-04-01').outputs.acrName.value]"
          },
          "tags": {
            "value": "[variables('commonTags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.49.2.45890",
              "templateHash": "14823813885237261095"
            }
          },
          "parameters": {
            "logAnalyticsName": {
              "type": "string",
              "metadata": {
                "description": "Log Analytics workspace name."
              }
            },
            "containerAppsEnvironmentName": {
              "type": "string",
              "metadata": {
                "description": "Container Apps Environment name."
              }
            },
            "managedIdentityName": {
              "type": "string",
              "metadata": {
                "description": "User Assigned Managed Identity name."
              }
            },
            "acrName": {
              "type": "string",
              "metadata": {
                "description": "Name of the ACR created by the parent deployment."
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Resource tags."
              }
            }
          },
          "variables": {
            "repositoryReaderCondition": "(\n  (\n    !(ActionMatches{'Microsoft.ContainerRegistry/registries/repositories/content/read'})\n    AND\n    !(ActionMatches{'Microsoft.ContainerRegistry/registries/repositories/metadata/read'})\n  )\n  OR\n  (\n    @Request[Microsoft.ContainerRegistry/registries/repositories:name] StringEqualsIgnoreCase 'product-api'\n  )\n)\n",
            "acrRepositoryReaderRoleId": "b93aa761-3e63-49ed-ac28-beffa264f7ac",
            "acrPullRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrRepositoryReaderRoleId'))]"
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2026-03-01",
              "name": "[parameters('logAnalyticsName')]",
              "location": "[resourceGroup().location]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": 30,
                "publicNetworkAccessForIngestion": "Enabled",
                "publicNetworkAccessForQuery": "Enabled"
              },
              "tags": "[parameters('tags')]"
            },
            {
              "type": "Microsoft.App/managedEnvironments",
              "apiVersion": "2026-01-01",
              "name": "[parameters('containerAppsEnvironmentName')]",
              "location": "[resourceGroup().location]",
              "properties": {
                "appLogsConfiguration": {
                  "destination": "log-analytics",
                  "logAnalyticsConfiguration": {
                    "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName')), '2026-03-01').customerId]",
                    "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName')), '2026-03-01').primarySharedKey]"
                  }
                }
              },
              "tags": "[parameters('tags')]",
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]"
              ]
            },
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2024-11-30",
              "name": "[parameters('managedIdentityName')]",
              "location": "[resourceGroup().location]",
              "tags": "[parameters('tags')]"
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
              "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), variables('acrRepositoryReaderRoleId'))]",
              "properties": {
                "roleDefinitionId": "[variables('acrPullRoleDefinitionId')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), '2024-11-30').principalId]",
                "principalType": "ServicePrincipal",
                "condition": "[variables('repositoryReaderCondition')]",
                "conditionVersion": "2.0"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName'))]"
              ]
            }
          ],
          "outputs": {
            "logAnalyticsWorkspaceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]"
            },
            "containerAppsEnvironmentId": {
              "type": "string",
              "value": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]"
            },
            "managedIdentityResourceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName'))]"
            },
            "managedIdentityPrincipalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), '2024-11-30').principalId]"
            },
            "managedIdentityClientId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), '2024-11-30').clientId]"
            }
          }
        }
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'acrDeployment')]",
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupId": {
      "type": "string",
      "value": "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
    },
    "acrId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'acrDeployment'), '2025-04-01').outputs.acrId.value]"
    },
    "acrLoginServer": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'acrDeployment'), '2025-04-01').outputs.acrLoginServer.value]"
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'containerPlatformDeployment'), '2025-04-01').outputs.logAnalyticsWorkspaceId.value]"
    },
    "containerAppsEnvironmentId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'containerPlatformDeployment'), '2025-04-01').outputs.containerAppsEnvironmentId.value]"
    },
    "managedIdentityResourceId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'containerPlatformDeployment'), '2025-04-01').outputs.managedIdentityResourceId.value]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'containerPlatformDeployment'), '2025-04-01').outputs.managedIdentityPrincipalId.value]"
    },
    "managedIdentityClientId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'containerPlatformDeployment'), '2025-04-01').outputs.managedIdentityClientId.value]"
    }
  }
}